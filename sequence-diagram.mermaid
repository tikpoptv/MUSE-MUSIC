sequenceDiagram
    participant U as User
    participant F as Frontend
    participant B as Backend
    participant G as Google OAuth
    participant DB as Database
    participant GA as GoogleAuthService
    participant US as UserService
    participant SS as SessionService
    participant JS as JWTService

    Note over U,JS: Google Authentication Flow - Detailed Service Level

    %% Step 1: User initiates Google auth
    U->>F: Click "Sign in with Google"
    F->>F: handleGoogleAuth() in GoogleAuthButton
    F->>F: Build Google OAuth URL with client_id, redirect_uri, scope
    F->>G: Redirect to Google OAuth

    %% Step 2: Google OAuth process
    G->>U: Show Google login/consent page
    U->>G: Enter credentials & authorize
    G->>F: Redirect to /auth/google/callback?code=xxx

    %% Step 3: Frontend callback handling
    F->>F: Extract code and error from URL params in callback page
    alt Google returns error parameter
        F->>F: Show error toast "Google authentication failed: " + error
        F->>F: router.push('/register')
    else No code received
        F->>F: Show error toast "No authorization code received from Google"
        F->>F: router.push('/register')
    else Code received successfully
        F->>B: POST /api/auth/google/callback<br/>{ code: "xxx" }
    end

    %% Step 4: Backend controller processes request
    B->>B: googleCallback() in authController
    B->>B: Validate code parameter
    alt Code is missing
        B->>F: Return 400 errorResponse('Authorization code is required')
    else Code is valid
        B->>G: POST https://oauth2.googleapis.com/token<br/>Exchange authorization code for tokens
        Note over B,G: client_id, client_secret, code, grant_type, redirect_uri
        alt Token exchange fails
            G->>B: Return error response
            B->>B: Throw error "Failed to exchange code for token"
        else Token exchange successful
            G->>B: Return { id_token: "xxx", access_token: "xxx", expires_in: 3600 }
            B->>B: Extract id_token from response
        end
    end

    %% Step 5: GoogleAuthService handles the flow
    B->>GA: GoogleAuthService.handleGoogleLogin(id_token, userAgent, ipAddress, userAgent)
    Note over B,GA: Parameters: googleToken, deviceInfo, ipAddress, userAgent<br/>Note: deviceInfo and ipAddress are extracted from request
    
    %% Step 6: Verify Google token
    GA->>GA: verifyGoogleToken(id_token)
    GA->>G: OAuth2Client.verifyIdToken() with audience validation
    alt Token verification fails
        G->>GA: Return null
        GA->>GA: Return null (invalid token)
    else Token verification successful
        G->>GA: Return verified payload { sub, email, name, picture, email_verified }
    end
    
    %% Step 7: Find or create user
    alt Google token is invalid
        GA->>GA: Throw error "Invalid Google token"
    else Google token is valid
        GA->>GA: findOrCreateGoogleUser(googleUserData)
        GA->>DB: SELECT * FROM Users WHERE providerID = googleId AND provider = 'google'
        
        alt User exists with Google ID
            DB->>GA: Return existing user data
            GA->>GA: Normalize user data and create User model
        else User doesn't exist
            GA->>US: UserService.findByEmail(email)
            US->>DB: SELECT * FROM Users WHERE email = email
            alt Email exists but not linked to Google
                DB->>US: Return existing user
                US->>GA: Return existing user
                GA->>GA: Throw error "Account exists but not linked to Google"
            else Email doesn't exist
                GA->>GA: createGoogleUser(googleUserData)
                GA->>DB: INSERT INTO Users (username, email, fullName, profilePicture, provider, providerID, providerEmail, role)
                Note over GA,DB: username = email.split('@')[0] + '_' + Date.now()
                DB->>GA: Return new user data
                GA->>GA: Normalize user data and create User model
            end
        end
    end

    %% Step 8: Update user login status
    GA->>US: UserService.updateLoginStatus(userID, 'online')
    US->>DB: UPDATE Users SET loginStatus = 'online', updatedAt = CURRENT_TIMESTAMP WHERE userID = userID
    DB->>US: Confirm update
    US->>GA: Update completed

    %% Step 9: Create session
    GA->>SS: SessionService.createSession(userID, deviceInfo, ipAddress, userAgent)
    SS->>DB: INSERT INTO UserSessions (userID, deviceInfo, ipAddress, userAgent, expiresAt)
    Note over SS,DB: expiresAt = 7 days from now
    DB->>SS: Return session data { sessionID, userID, deviceInfo, ipAddress, userAgent, isActive, expiresAt, createdAt }
    SS->>GA: Return session object

    %% Step 10: Generate JWT tokens
    GA->>JS: JWTService.generateAccessToken(userID, username, role)
    JS->>JS: Create payload { userID, username, role, type: 'access' }
    JS->>JS: Sign with JWT secret, expiresIn: '7d', issuer: 'muse-music-api'
    JS->>GA: Return access token

    GA->>JS: JWTService.generateRefreshToken(userID)
    JS->>JS: Create payload { userID, type: 'refresh' }
    JS->>JS: Sign with JWT secret, expiresIn: '30d', issuer: 'muse-music-api'
    JS->>GA: Return refresh token

    %% Step 11: Return response
    GA->>B: Return { user, session, tokens: { accessToken, refreshToken, tokenType: 'Bearer', expiresIn: '7d' } }
    B->>F: Return successResponse('Google authentication successful', result)
    
    %% Error handling in backend
    alt Account exists but not linked to Google
        GA->>B: Throw error "Account exists but not linked to Google"
        B->>F: Return 409 errorResponse with message
    else Other errors
        GA->>B: Throw generic error
        B->>F: Return 500 errorResponse "Google authentication failed"
    end

    %% Step 12: Frontend handles response
    alt Backend response is not ok
        F->>F: Parse errorData from response
        alt Status 409 and message contains "Account exists but not linked to Google"
            F->>F: Show error toast "Account exists but not linked to Google. Please link your Google account first or register with Google."
            F->>F: router.push('/register')
        else Other error
            F->>F: Show error toast "Failed to exchange code for token: " + errorData.message
            F->>F: router.push('/register')
        end
    else Backend response is ok
        F->>F: Parse data from response
        alt data.success && data.data exists
            F->>F: authService.setToken(data.data.tokens.accessToken)
            F->>F: Show success toast "Successfully signed in with Google!"
            F->>F: router.push('/') - Redirect to home page
        else Authentication failed
            F->>F: Show error toast "Authentication failed"
            F->>F: router.push('/register')
        end
    end

    Note over U,JS: User successfully authenticated with Google
