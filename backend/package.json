{
  "name": "muse-music-backend",
  "version": "1.0.0",
  "description": "Backend API for MUSE Music application",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "node database/scripts/migrate.js",
    "migrate:dev": "NODE_ENV=development node database/scripts/migrate.js",
    "migrate:prod": "NODE_ENV=production node database/scripts/migrate.js",
    "db:reset": "node database/scripts/clean-reset.js",
    "db:reset:dev": "NODE_ENV=development node database/scripts/clean-reset.js",
    "db:reset:prod": "NODE_ENV=production node database/scripts/clean-reset.js",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:unit": "jest --testPathIgnorePatterns=/src/__tests__/integration/ --passWithNoTests",
    "test:unit:ci": "jest --testPathIgnorePatterns=/src/__tests__/integration/ --ci --coverage --watchAll=false --passWithNoTests",
    "test:integration": "jest --testPathPatterns=src/__tests__/integration/ --passWithNoTests",
    "test:integration:ci": "jest --testPathPatterns=src/__tests__/integration/ --ci --coverage --watchAll=false --passWithNoTests",
    "lint": "eslint . --ext .js"
  },
  "keywords": [
    "music",
    "api",
    "express",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.4",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "nodemon": "^3.0.2"
  }
}
