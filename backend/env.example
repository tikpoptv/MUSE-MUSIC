# ===========================================
# MUSE MUSIC BACKEND - Environment Variables
# ===========================================

# Server Configuration
BACKEND_PORT=3001
BACKEND_HOST=api.musemusic.com
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=muse_music
DB_USER=postgres
DB_PASSWORD=your_password_here

# CORS Configuration
# ใช้กำหนดที่มาที่อนุญาต (Origin/Referer) สำหรับขาเพลง (lyrics) ด้วย
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
# อายุโทเค็น กำหนดได้ (ดีฟอลต์ 7d/30d หากไม่ตั้งค่า)
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# N8N Email Service Configuration
EMAIL_N8N_USERNAME=
EMAIL_N8N_PASSWORD=
EMAIL_N8N_WEBHOOK_URL=

# Analysis/Translate Webhook (ถ้ามีใช้งาน)
TRANSLATE_WEBHOOK=

# LRCLIB (Lyrics) Configuration
# Base URL และ User-Agent สำหรับเรียก LRCLIB
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_USER_AGENT=MUSE-MUSIC Backend (https://github.com/tikpoptv/MUSE-MUSIC)

# MinIO Configuration
# สำหรับเก็บรูปภาพและไฟล์ต่างๆ
MINIO_ENDPOINT=musemusic.minio.phitik.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=muse-music
MINIO_PUBLIC_URL=https://musemusic.minio.phitik.com
