# ===========================================
# MUSE MUSIC BACKEND - Environment Variables
# ===========================================

# Server Configuration
BACKEND_PORT=3001
BACKEND_HOST=api.musemusic.com
NODE_ENV=development

# Database Configuration
# Dev: Use localhost:7770 when running npm run dev (connects to docker-compose.infra.dev.yml)
# Production: Use actual production database values
DB_HOST=localhost
DB_PORT=7770
DB_NAME=muse_music
DB_USER=postgres
DB_PASSWORD=postgres123

# CORS Configuration
# Used to define allowed origins (Origin/Referer) for lyrics endpoints as well
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
# Token expiration time (defaults to 7d/30d if not set)
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# N8N Email Service Configuration
# Dev: n8n runs at http://localhost:7773 (from docker-compose.infra.dev.yml)
# Production: Use actual production n8n values
EMAIL_N8N_USERNAME=
EMAIL_N8N_PASSWORD=
EMAIL_N8N_WEBHOOK_URL=http://localhost:7773/

# Analysis/Translate Webhook (if used)
TRANSLATE_WEBHOOK=
TRANSLATE_TEST_WEBHOOK=

# N8N Workflow API Configuration
# Dev: n8n runs at http://localhost:7773 (from docker-compose.infra.dev.yml)
# Production: Use actual production n8n values
N8N_API_KEY=your-n8n-api-key-here
N8N_WORKFLOW_URL=http://localhost:7773/api/v1/workflows/your-workflow-id-here
N8N_WORKFLOW_TEST_URL=http://localhost:7773/api/v1/workflows/your-test-workflow-id-here

# LRCLIB (Lyrics) Configuration
# Base URL and User-Agent for calling LRCLIB
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_USER_AGENT=MUSE-MUSIC Backend (https://github.com/tikpoptv/MUSE-MUSIC)

# MinIO Configuration
# For storing images and files
# Dev: Use localhost:7771 when running npm run dev (connects to docker-compose.infra.dev.yml)
# Production: Use actual production MinIO values
MINIO_ENDPOINT=localhost
MINIO_PORT=7771
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret_password
MINIO_BUCKET_NAME=muse-music
MINIO_PUBLIC_URL=http://localhost:7771

# YouTube Data API v3 Configuration
# For searching YouTube videos by song name
# See how to create API Key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key-here

# YouTube Transcript Service Configuration
# Python binary used to run the transcript script (after running scripts/setup_transcript_env.sh)
YT_TRANSCRIPT_PYTHON=./.transcript-venv/bin/python
# Comma-separated fallback language order
YT_TRANSCRIPT_LANGUAGES=th,en
# Set true to keep HTML formatting tags
YT_TRANSCRIPT_PRESERVE=false
